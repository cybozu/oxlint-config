{
  "name": "@cybozu/oxlint-config",
  "type": "module",
  "repository": "cybozu/oxlint-config",
  "homepage": "https://github.com/cybozu/oxlint-config",
  "bugs": "https://github.com/cybozu/oxlint-config/issues",
  "version": "0.3.0",
  "description": "An oxlint rule-set for Cybozu.",
  "files": [
    "dist"
  ],
  "exports": {
    "./presets/base": {
      "types": "./dist/presets/base.d.ts",
      "default": "./dist/presets/base.js"
    },
    "./presets/kintone-customize": {
      "types": "./dist/presets/kintone-customize.d.ts",
      "default": "./dist/presets/kintone-customize.js"
    },
    "./presets/node": {
      "types": "./dist/presets/node.d.ts",
      "default": "./dist/presets/node.js"
    },
    "./presets/node-typescript": {
      "types": "./dist/presets/node-typescript.d.ts",
      "default": "./dist/presets/node-typescript.js"
    },
    "./presets/react": {
      "types": "./dist/presets/react.d.ts",
      "default": "./dist/presets/react.js"
    },
    "./presets/react-typescript": {
      "types": "./dist/presets/react-typescript.d.ts",
      "default": "./dist/presets/react-typescript.js"
    },
    "./presets/typescript": {
      "types": "./dist/presets/typescript.d.ts",
      "default": "./dist/presets/typescript.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "oxlint",
    "oxlint-config",
    "linter",
    "cybozu"
  ],
  "author": "cybozu",
  "license": "MIT",
  "peerDependencies": {
    "oxlint": ">=1.66.0",
    "oxlint-tsgolint": ">=0.23.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.9",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
