{
  "name": "@cybozu/oxlint-config",
  "type": "module",
  "repository": "cybozu/oxlint-config",
  "homepage": "https://github.com/cybozu/oxlint-config",
  "bugs": "https://github.com/cybozu/oxlint-config/issues",
  "version": "0.2.0",
  "description": "An oxlint rule-set for Cybozu.",
  "main": "./dist/index.js",
  "files": [
    "src/presets"
  ],
  "exports": {
    ".": "./src/presets/base.oxlintrc.json",
    "./presets/base": "./src/presets/base.oxlintrc.json",
    "./presets/es5": "./src/presets/es5.oxlintrc.json",
    "./presets/kintone-customize": "./src/presets/kintone-customize.oxlintrc.json",
    "./presets/kintone-customize-es5": "./src/presets/kintone-customize-es5.oxlintrc.json",
    "./presets/node": "./src/presets/node.oxlintrc.json",
    "./presets/react": "./src/presets/react.oxlintrc.json",
    "./presets/react-typescript": "./src/presets/react-typescript.oxlintrc.json",
    "./presets/typescript": "./src/presets/typescript.oxlintrc.json"
  },
  "scripts": {},
  "keywords": [
    "oxlint",
    "oxlint-config",
    "oxfmt",
    "linter",
    "typescript",
    "cybozu"
  ],
  "author": "cybozu",
  "license": "MIT",
  "peerDependencies": {
    "oxlint": ">=1.65.0",
    "oxlint-tsgolint": ">=0.22.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.22.1"
  }
}
