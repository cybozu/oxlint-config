{
  "name": "@cybozu/oxlint-config",
  "type": "module",
  "repository": "cybozu/oxlint-config",
  "homepage": "https://github.com/cybozu/oxlint-config",
  "bugs": "https://github.com/cybozu/oxlint-config/issues",
  "version": "0.2.0",
  "description": "An oxlint rule-set for Cybozu.",
  "files": [
    "src/presets"
  ],
  "exports": {
    ".": "./src/presets/base.ts",
    "./presets/base": "./src/presets/base.ts",
    "./presets/kintone-customize": "./src/presets/kintone-customize.ts",
    "./presets/node": "./src/presets/node.ts",
    "./presets/react": "./src/presets/react.ts",
    "./presets/react-typescript": "./src/presets/react-typescript.ts",
    "./presets/typescript": "./src/presets/typescript.ts"
  },
  "scripts": {},
  "keywords": [
    "oxlint",
    "oxlint-config",
    "oxfmt",
    "linter",
    "typescript",
    "cybozu"
  ],
  "author": "cybozu",
  "license": "MIT",
  "peerDependencies": {
    "oxlint": ">=1.65.0",
    "oxlint-tsgolint": ">=0.22.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.22.1"
  },
  "packageManager": "pnpm@11.0.9",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
